#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 6

#include <behaviors/rgbled_widget.dtsi>  // needed to use the behaviors
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        shift+tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <19 18>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Mac-Default_Layer {
            bindings = <
&kp Q      &kp W         &kp E         &kp R                        &kp T                                     &kp Y        &kp U                     &kp I          &kp O          &kp P
&kp A      &kp S         &kp D         &kp F                        &kp G                                     &kp H        &kp J                     &kp K          &kp L          &kp MINUS
&kp Z      &kp X         &kp C         &kp V                        &kp B        &mt LEFT_SHIFT SINGLE_QUOTE  &kp N        &kp M                     &kp COMMA      &kp PERIOD     &mt LCTRL SLASH
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 3 LANGUAGE_2  &lt 2 SPACE  &lt 7 LANGUAGE_1             &lt 1 ENTER  &mt LEFT_SHIFT SEMICOLON  &kp BACKSPACE  &lt 4 PAGE_UP  &lt 8 PAGE_DOWN
            >;
        };

        Win-Default_Layer {
            bindings = <
&kp MINUS             &kp N7  &kp N8  &kp N9  &kp LS(PLUS)             &kp EQUAL          &kp CARET         &kp PLUS         &kp ASTERISK     &kp LPAR
&kp N0                &kp N4  &kp N5  &kp N6  &kp LS(STAR)             &kp EXCLAMATION    &kp LEFT_BRACKET  &kp POUND        &kp DOLLAR       &kp PERCENT
&mt LEFT_SHIFT SLASH  &kp N1  &kp N2  &kp N3  &kp DOT       &kp UNDER  &kp RIGHT_BRACKET  &kp BACKSLASH     &kp RIGHT_BRACE  &kp PIPE         &mt LCTRL INTERNATIONAL_1
&kp RIGHT_BRACKET     &trans  &trans  &trans  &trans        &trans     &trans             &kp LEFT_BRACE    &trans           &lt 2 LS(LG(S))  &kp LS(INTERNATIONAL_3)
            >;
        };

        Mac-Function_Layer {
            bindings = <
&kp ESCAPE  &kp LC(LS(TAB))  &kp UP_ARROW  &kp LC(TAB)  &kp LG(F)          &kp F5             &kp LG(LEFT)  &kp LG(RIGHT)  &kp LG(LC(LEFT))  &kp LG(LC(RIGHT))
&kp HOME    &kp LEFT         &kp DOWN      &kp RIGHT    &kp END            &kp LC(F)          &mkp MB1      &kp LG(TAB)    &mkp MB2          &kp F7
&kp LC(Z)   &kp LC(X)        &kp LC(C)     &kp LC(V)    &kp LC(A)  &trans  &kp LC(PAGE_DOWN)  &mkp MB4      &kp PG_DN      &mkp MB5          &kp LS(LC(T))
&trans      &trans           &trans        &trans       &trans     &trans  &trans             &kp LG(T)     &kp DELETE     &kp LS(LG(S))     &kp END
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Win-Function_Layer {
            bindings = <
&kp LA(Q)  &kp LA(W)  &kp LA(E)  &kp LA(R)  &kp LA(T)                 &kp LA(Y)      &kp LA(U)     &kp LA(I)      &kp LA(O)    &kp LA(P)
&kp LA(A)  &kp LA(S)  &kp LA(D)  &kp LA(F)  &kp LA(G)                 &kp LA(H)      &kp LA(J)     &kp LA(K)      &kp LA(L)    &kp LA(MINUS)
&kp LA(Z)  &kp LA(X)  &kp LA(C)  &kp LA(V)  &kp LA(B)  &kp LA(COLON)  &kp LA(N)      &kp LA(M)     &kp LA(COMMA)  &kp LA(DOT)  &kp LA(FSLH)
&trans     &trans     &trans     &trans     &trans     &trans         &kp LA(ENTER)  &kp LA(SEMI)  &trans         &trans       &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Mac-Common_Layer {
            bindings = <
&kp ESCAPE   &kp LA(LC(LG(N2)))  &kp LC(LA(LG(NUMBER_3)))  &kp LG(LC(LA(N4)))  &kp LA(LC(LG(N5)))           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans       &kp LC(N4)          &kp LC(N5)                &kp LC(N6)          &trans                       &trans        &trans        &trans        &trans        &trans
&trans       &kp LC(N1)          &kp LC(N2)                &kp LC(N3)          &trans              &kp INS  &trans        &trans        &bootloader   &trans        &bt BT_CLR
&bootloader  &trans              &trans                    &trans              &trans              &trans   &trans        &kp LG(T)     &trans        &trans        &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Win-Common_Layer {
            bindings = <
&kp LS(LC(LEFT))  &kp LC(LEFT)  &kp LS(UP)    &kp LC(RIGHT)  &kp LS(LC(RIGHT))          &trans        &trans       &trans  &trans  &kp LC(W)
&kp LS(HOME)      &kp LS(LEFT)  &kp LS(DOWN)  &kp LS(RIGHT)  &kp LS(END)                &trans        &trans       &trans  &trans  &kp LG(UP)
&trans            &trans        &trans        &trans         &trans             &trans  &kp LC(HOME)  &trans       &trans  &trans  &kp LG(DOWN)
&trans            &trans        &trans        &trans         &trans             &trans  &trans        &kp LC(END)  &trans  &trans  &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_9 {
            bindings = <
&trans       &kp LG(N7)  &kp LG(E)   &kp LG(LC(LA(N4)))  &trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans       &kp LG(N4)  &kp LG(N5)  &kp LG(N6)          &trans          &trans        &trans        &trans        &trans        &trans
&trans       &kp LG(N1)  &kp LG(N2)  &kp LG(N3)          &trans  &kp F2  &trans        &trans        &trans        &trans        &bt BT_CLR
&bootloader  &trans      &trans      &trans              &trans  &trans  &trans        &trans        &trans        &trans        &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Num_Layer {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5           &kp PLUS      &kp MINUS   &kp NUMBER_7   &kp NUMBER_8   &kp NUMBER_9
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10          &kp EQUAL     &kp COLON   &kp N4         &kp N5         &kp N6
&kp F11  &kp F12  &trans  &trans  &trans   &trans  &kp ASTERISK  &kp SLASH   &kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3
&trans   &trans   &trans  &trans  &trans   &trans  &kp ENTER     &kp DOLLAR  &kp BACKSPACE  &kp AMPERSAND  &kp N0
            >;
        };

        Setting_Layer {
            bindings = <
&studio_unlock  &trans  &trans  &trans  &trans         &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans          &trans  &trans  &trans  &trans         &trans        &trans          &trans        &trans        &trans
&trans          &trans  &trans  &trans  &trans  &to 0  &ind_bat      &trans          &trans        &trans        &bt BT_CLR
&trans          &trans  &trans  &trans  &trans  &to 1  &bootloader   &studio_unlock  &sys_reset    &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        AutoMouse_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans          &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
            >;
        };
    };
};
